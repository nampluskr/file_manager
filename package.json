{
  "name": "personal-file-manager",
  "version": "0.1.0",
  "author": "nampluskr",
  "private": true,
  "description": "A keyboard-driven dual-pane Windows file manager for launching terminal CLI agents from the current directory.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:boundary": "node scripts/checkFilesystemBoundary.mjs",
    "test": "npm run check:boundary && vitest run",
    "package:win": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.nampluskr.personalfilemanager",
    "productName": "Personal File Manager",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": ["portable"] },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
